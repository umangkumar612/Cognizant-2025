public class Solution {
    public int RemoveDuplicates(int[] nums) {
        int n = nums.Length;
        if(n  == 0){
            return 0;
        }
         int j = 0;
        for(int i = 0; i < n; i++){
           
            if(nums[j] != nums[i]){
                j++;
            }
            nums[j] = nums[i];
        }
        return j+1;
    }
}
